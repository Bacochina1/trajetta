datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          String         @default("USER")
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  habits        Habit[]
  goals         Goal[]
  journeys      Journey[]
  weeklyReviews WeeklyReview[]
  dailyLogs     DailyLog[]
  memories      UserMemory[]
  contextSummary UserContextSummary?
}

model Habit {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  area          String
  frequency     String
  targetValue   String
  streakWeeks   Int      @default(0)
  completedDays String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Goal {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  area                  String
  whyItMatters          String
  targetMetric          String
  milestones            String
  currentMilestoneIndex Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Journey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  area        String
  description String
  totalDays   Int      @default(30)
  currentDay  Int      @default(1)
  slipDays    Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WeeklyReview {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber     Int
  year           Int
  wins           String
  challenges     String
  aiReflection   String
  northStarWeeks Int      @default(0)
  createdAt      DateTime @default(now())
}

model DailyLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String
  quickNote        String
  consistencyScore Int      @default(0)
  createdAt        DateTime @default(now())
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("landing_page")
  createdAt DateTime @default(now())
}

model UserMemory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryType     String   // preference, goal, behavior_pattern, difficulty, achievement, life_context, decision, relationship, routine, motivation, constraint
  content        String
  embedding      String?  // JSON float array vector representation
  importance     Float    @default(0.5) // 0.0 to 1.0
  confidence     Float    @default(0.8) // 0.0 to 1.0
  source         String?  // weekly_review, habit_log, conversation, user_input
  sourceId       String?
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, memoryType])
}

model UserContextSummary {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary         String
  focusAreas      String   @default("[]")
  keyDifficulties String   @default("[]")
  keyWins         String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

