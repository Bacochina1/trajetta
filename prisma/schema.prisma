datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String
  passwordHash       String
  role               String               @default("USER")
  avatar             String?
  timezone           String               @default("America/Sao_Paulo")
  currentLifePhase   String?              @default("Consistência & Fundação")
  subscriptionStatus String               @default("trial")
  trialEndsAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  habits             Habit[]
  habitLogs          HabitLog[]
  goals              Goal[]
  journeys           Journey[]
  journeyLogs        JourneyLog[]
  weeklyReviews      WeeklyReview[]
  weeklyPlans        WeeklyPlan[]
  weeklySnapshots    WeeklySnapshot[]
  activityEvents     ActivityEvent[]
  dailyLogs          DailyLog[]
  memories           UserMemory[]
  contextSummary     UserContextSummary?
  emailLogs          EmailLog[]
}

model Habit {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  area             String
  frequency        String
  frequencyPerWeek Int        @default(4)
  targetValue      String?
  streakWeeks      Int        @default(0)
  iconName         String?
  completedDays    String     @default("[]")
  logs             HabitLog[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  completed Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId, date])
}

model Goal {
  id                    String          @id @default(cuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  area                  String
  whyItMatters          String
  priority              String          @default("principal") // principal, secundaria, manutencao
  status                String          @default("active")    // active, completed, paused
  targetMetric          String?
  progress              Int             @default(0)
  targetDate            String?
  milestones            GoalMilestone[]
  actions               GoalAction[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([userId, status])
}

model GoalMilestone {
  id          String    @id @default(cuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  targetValue String?
  completed   Boolean   @default(false)
  order       Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([goalId])
}

model GoalAction {
  id                String   @id @default(cuid())
  goalId            String
  goal              Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title             String
  isControllable    Boolean  @default(true)
  dayOfWeek         Int?
  completedToday    Boolean  @default(false)
  lastCompletedDate String?
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([goalId])
}

model Journey {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  area        String
  description String
  totalDays   Int          @default(30)
  currentDay  Int          @default(1)
  slipDays    Int          @default(0)
  status      String       @default("active")
  logs        JourneyLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status])
}

model JourneyLog {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayNumber Int
  date      String
  status    String   // completed, slip
  notes     String?
  createdAt DateTime @default(now())

  @@index([journeyId])
  @@index([userId])
}

model WeeklyPlan {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber        Int
  year              Int
  northStarGoal     String?
  areaPriorities    String   @default("{}") // JSON { corpo, dinheiro, carreira, vida }
  perceivedCapacity String   @default("normal") // leve, normal, intensa
  weekIntention     String?
  isCompleted       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, weekNumber, year])
}

model WeeklyReview {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber     Int
  year           Int
  wins           String
  challenges     String
  aiReflection   String
  northStarWeeks Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([userId, year, weekNumber])
}

model WeeklySnapshot {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber       Int
  year             Int
  actionsPlanned   Int      @default(0)
  actionsCompleted Int      @default(0)
  habitsActive     Int      @default(0)
  habitsCompleted  Int      @default(0)
  focusAreas       String   @default("[]") // JSON
  summary          String
  rawSnapshotJson  String   @default("{}") // JSON
  createdAt        DateTime @default(now())

  @@index([userId, year, weekNumber])
}

model ActivityEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType   String   // goal_created, goal_completed, milestone_completed, action_completed, habit_logged, journey_started, journey_slip, weekly_review_completed, life_event
  title       String
  description String?
  lifeArea    String?
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  @@index([userId, eventType])
  @@index([userId, createdAt])
}

model DailyLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String
  quickNote        String
  consistencyScore Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, date])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("landing_page")
  createdAt DateTime @default(now())
}

model UserMemory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryType     String   // preference, goal, behavior_pattern, difficulty, achievement, life_context, decision, relationship, routine, motivation, constraint
  content        String
  embedding      String?  // JSON float array vector representation
  importance     Float    @default(0.5) // 0.0 to 1.0
  confidence     Float    @default(0.8) // 0.0 to 1.0
  source         String?  // weekly_review, habit_log, conversation, user_input
  sourceId       String?
  state          String   @default("active") // active, stale, superseded, deleted
  supersededById String?
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, memoryType])
  @@index([userId, state])
}

model UserContextSummary {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary         String
  focusAreas      String   @default("[]")
  keyDifficulties String   @default("[]")
  keyWins         String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmailLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  to         String
  subject    String
  status     String   // delivered, sandbox_simulated, failed
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

